APP_NAME=Personal API Platform
APP_ENV=development
APP_DEBUG=false
APP_VERSION=1.0.0

API_PREFIX=/api/v1
HOST_IP=192.168.25.101
PORT=8000

# Dedicated PAP core database; provision separately.
PAP_DATABASE_URL=postgresql+psycopg://pap_user:REPLACE_ME@100.106.63.90:5432/pap_core

# Existing PSM database reference; do not migrate it as PAP core by default.
PSM_DATABASE_HOST=100.106.63.90
PSM_DATABASE_PORT=5432
PSM_DATABASE_NAME=psm
PSM_DATABASE_USER=appuser
PSM_DATABASE_PASSWORD=REPLACE_ME

# Restricted Stock UMKM integration account; do not use MySQL root.
STOCK_DB_HOST=100.106.63.90
STOCK_DB_PORT=3306
STOCK_DB_NAME=stock_umkm
STOCK_DB_USER=pap_stock_reader
STOCK_DB_PASSWORD=REPLACE_ME
STOCK_UMKM_API_URL=http://192.168.25.101:8080/api
STOCK_UMKM_API_KEY=REPLACE_ME

# POS Cashier integration
POS_CASHIER_WEBHOOK_URL=http://192.168.25.101:3000/api/webhooks/pap

# Personal Server Manager & IoT Dashboard Integration
PSM_API_URL=http://192.168.25.101:8001/api/v1
IOT_DASHBOARD_API_URL=http://192.168.25.101:8002/api
PAP_PSM_SERVICE_KEY=pap_key_psm_control_plane_default_secret_key_2026
PAP_IOT_SERVICE_KEY=pap_key_iot_dashboard_default_secret_key_2026
ONLINE_THRESHOLD_MINUTES=5

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG
JWT_ISSUER=personal-api-platform
JWT_AUDIENCE=pap-clients
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

PROMETHEUS_URL=http://host.docker.internal:9001

MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_USERNAME=REPLACE_ME
MQTT_PASSWORD=REPLACE_ME
MQTT_ENABLED=false

DOCKER_EXECUTOR_ENABLED=false
DOCKER_EXECUTOR_URL=http://127.0.0.1:2375

RATE_LIMIT_REQUESTS_PER_MINUTE=120
CORS_ORIGINS=http://192.168.25.101,http://192.168.25.101:3000,http://192.168.25.101:3001

